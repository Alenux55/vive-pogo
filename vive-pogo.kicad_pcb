	(gr_text_box "${ProjectTitle} R${ProjectPCBRevision} ${ProjectPCBReleaseDate}"
		(start 148.75 98.130795)
		(end 155.55 102.169205)
		(margins 0 0 0 0)
		(layer "B.SilkS")
		(uuid "33ad43a5-3e55-4802-907c-3d7a4436c126")
		(effects
			(font
